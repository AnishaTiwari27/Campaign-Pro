node_modules/

# Frontend build output.
frontend/dist/
frontend/tsconfig.tsbuildinfo
frontend/test-results/

# Local binaries from `make build`.
bin/

# The frontend build is copied here to be embedded in the binary (see
# backend/web). Only the .gitkeep is tracked, so a build is never committed
# and `go build` still works in a fresh checkout.
backend/web/dist/*
!backend/web/dist/.gitkeep
