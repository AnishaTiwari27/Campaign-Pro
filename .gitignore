# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Claude Code's own local tool-permission config — this session's
# accumulated command allowlist (local file paths, dev-only passwords
# already documented elsewhere), not project source. Not something a
# collaborator cloning the repo needs.
.claude/

# Go build artifacts (none checked in today, but guard against it)
/bin/
*.test
*.out

# Redis persistence snapshot — runtime data, not source, regenerated by
# `redis-server --daemonize yes` (see the dev-stack memory / docs).
dump.rdb

# Frontend has its own .gitignore (node_modules/, dist/, .env.local) —
# nested .gitignore files apply automatically, not duplicated here.
